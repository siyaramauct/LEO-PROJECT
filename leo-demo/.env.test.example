# Credentials for the integration tests (npm run test:integration).
#
# These belong to the LOCAL Supabase in Docker, never the hosted project: the
# tests create and delete data, and the secret key bypasses every RLS policy.
#
# On your machine: start the stack (npx supabase start), copy this file to
# .env.test (ignored by git) and fill in the values from:
#   npx supabase status -o env
#     VITE_SUPABASE_URL              <- API_URL
#     VITE_SUPABASE_PUBLISHABLE_KEY  <- PUBLISHABLE_KEY
#     SUPABASE_SECRET_KEY            <- SECRET_KEY
#
# In GitHub Actions: nothing to copy and no GitHub Secrets. The workflow starts
# its own local Supabase, reads that run's values with the same command, and
# sets them as environment variables, which take priority over .env.test.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=local-publishable-key
SUPABASE_SECRET_KEY=local-secret-key
