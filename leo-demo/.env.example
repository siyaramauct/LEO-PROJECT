# Copy this file to .env and fill in your own values. .env is ignored by git.
# Both values are in the Supabase dashboard under Project Settings > API.
# Only the publishable (anon) key belongs here: it ships to every browser.
# Never put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
